FROM mcr.microsoft.com/cbl-mariner/base/core:2.0

WORKDIR /app

RUN tdnf update -y && \
    tdnf install -y \
        git \
        gcc \
        gobject-introspection-devel \
        cairo-gobject \
        cairo-devel \
        pkg-config \
        libvirt-devel \
        python3-devel \
        python3-pip \
        python3-virtualenv \
        build-essential \
        cairo-gobject-devel \
        curl \
        wget \
        tar \
        azure-cli \
        ca-certificates && \
    tdnf clean all && \
    rm -rf /var/cache/tdnf /tmp/*

RUN AZCOPY_URL="$(curl -fsSL https://api.github.com/repos/Azure/azure-storage-azcopy/releases/latest | \
        python3 -c 'import json, sys; release = json.load(sys.stdin); print(next(asset["browser_download_url"] for asset in release["assets"] if asset["name"].startswith("azcopy_linux_amd64_") and asset["name"].endswith(".tar.gz")))')" && \
    wget "$AZCOPY_URL" -O azcopy.tar.gz && \
    tar -xvf azcopy.tar.gz && \
    mv azcopy*/azcopy /usr/local/bin/ && \
    rm -rf azcopy*

ENV LISA_azcopy_path="/usr/local/bin/azcopy"
ENV SETUPTOOLS_SCM_PRETEND_VERSION="__version__"

WORKDIR /app/lisa

COPY . .

RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir --editable .[ado,azure,libvirt,baremetal] --config-settings editable_mode=compat
